{
  "appId": "com.nanowork",
  "productName": "nanowork",
  "icon": "electron/assets/icon",
  "protocols": [
    {
      "name": "NanoWork",
      "schemes": ["nanowork"]
    }
  ],
  "directories": {
    "output": "release",
    "buildResources": "electron/assets"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "bwshark",
      "repo": "nanowork",
      "releaseType": "release"
    }
  ],
  "files": [
    "dist/**/*",
    "electron/main.cjs",
    "electron/preload.cjs",
    "electron/splashPreload.cjs",
    "electron/splash.html",
    "electron/assets/**/*",
    "resources/**/*",
    "node_modules/node-pty/**/*"
  ],
  "asarUnpack": [
    "node_modules/node-pty/**/*"
  ],
  "extraResources": [
    {
      "from": "build/rt",
      "to": "rt"
    },
    {
      "from": "examples/extensions",
      "to": "extensions-samples"
    }
  ],
  "asar": true,
  "npmRebuild": false,
  "artifactName": "nanowork-${version}-${os}-${arch}.${ext}",
  "afterSign": "scripts/sign-engine-macos.mjs",
  "mac": {
    "target": [{ "target": "dmg" }, { "target": "zip" }],
    "category": "public.app-category.productivity",
    "icon": "electron/assets/icon.icns",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "electron/assets/entitlements.mac.plist",
    "entitlementsInherit": "electron/assets/entitlements.mac.plist",
    "notarize": false,
    "extendInfo": {
      "NSMicrophoneUsageDescription": "nanowork 需要使用麦克风进行语音输入：录音在本地完成，仅把音频发送到你配置的转录服务转成文字。",
      "NSSpeechRecognitionUsageDescription": "nanowork 使用语音识别把你说的话转成文字填入输入框。"
    }
  },
  "dmg": {
    "title": "NanoWork"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "electron/assets/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true
  },
  "linux": {
    "maintainer": "bwshark <bwshark@users.noreply.github.com>",
    "target": ["AppImage", "deb"],
    "category": "Utility",
    "synopsis": "NanoWork 智能体客户端",
    "description": "基于 nanobot 引擎的桌面智能体客户端：会话、任务、知识库与模型渠道统一管理。",
    "icon": "electron/assets/icon.png",
    "desktop": {
      "entry": {
        "Name": "NanoWork",
        "Comment": "NanoWork 智能体客户端",
        "Categories": "Utility;Development;"
      }
    }
  },
  "electronDownload": {
    "mirror": "https://npmmirror.com/mirrors/electron/"
  }
}
