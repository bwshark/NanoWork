{
  "appId": "com.nanowork",
  "productName": "nanowork",
  "icon": "electron/assets/icon",
  "protocols": [
    {
      "name": "NanoWork",
      "schemes": ["nanowork"]
    }
  ],
  "directories": {
    "output": "release"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "bwshark",
      "repo": "nanowork",
      "releaseType": "release"
    }
  ],
  "files": [
    "dist/**/*",
    "electron/main.cjs",
    "electron/preload.cjs",
    "electron/splashPreload.cjs",
    "electron/splash.html",
    "electron/assets/**/*",
    "resources/**/*"
  ],
  "extraResources": [
    {
      "from": "build/rt",
      "to": "rt"
    }
  ],
  "asar": true,
  "npmRebuild": false,
  "artifactName": "nanowork-${version}-${os}-${arch}.${ext}",
  "mac": {
    "target": [
      { "target": "dmg", "arch": ["arm64", "x64"] },
      { "target": "zip", "arch": ["arm64", "x64"] }
    ],
    "category": "public.app-category.productivity",
    "icon": "electron/assets/icon.icns",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "electron/assets/entitlements.mac.plist",
    "entitlementsInherit": "electron/assets/entitlements.mac.plist",
    "extendInfo": {
      "NSMicrophoneUsageDescription": "nanowork 需要使用麦克风进行语音输入：录音在本地完成，仅把音频发送到你配置的转录服务转成文字。",
      "NSSpeechRecognitionUsageDescription": "nanowork 使用语音识别把你说的话转成文字填入输入框。"
    }
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "electron/assets/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Utility",
    "icon": "electron/assets/icon.png"
  },
  "electronDownload": {
    "mirror": "https://npmmirror.com/mirrors/electron/"
  }
}
