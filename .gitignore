# Python (project-local venv for nanobot)
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
nanobot/
.nanowork-workspace/
# 工作区记忆/身份等产品数据的落点（`<工作目录>/.nanowork/`）。2026-09-19 起应用会把
# 工作区级记忆写到**用户的工作目录**下，本仓自己也会被写入——别把记忆文件提交上来。
.nanowork/

# Node / frontend build
node_modules/
dist/
dist-qa/
dist-ui/
dist-rollback/
dist-auto-ui/
dist-verify/
*.local

# Electron build artifacts (generated by build:electron)
electron/main.cjs
electron/preload.cjs
release/
run/

# Env / secrets
.env
.env.*
!.env.example
nanowork.config.yaml
nanowork.config.yml
nanowork.config.json
pairing.json
weixin/
cli-apps/*_registry_cache.json

# Runtime data（每次运行都会变，禁止入库）
llm_usage.sqlite3
llm_usage.sqlite3-shm
llm_usage.sqlite3-wal
temp-review-diff.txt

# Editor / OS
.vscode/
.idea/
.DS_Store
.workbuddy/
.codebuddy/
.claude/
.lingma/
.qoder/
.trae/

# Logs
*.log
.vitest
tests/
sessions
run/
webui/
temp/
media/
# ⚠️ 必须带前导 `/`：不带斜杠的 `tasks/` 会匹配**任意层级**名为 tasks 的目录，
# 于是 `src/components/tasks/` 与 `src/pages/tasks/` 也被静默忽略——那两处是**源码**，
# 一旦没进版本库，误删/换工作区就再也找不回来（2026-09-19 实际发生过一次）。
# 这里只忽略仓库根目录下存放截图的 tasks/。
tasks/
